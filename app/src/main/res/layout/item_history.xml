<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@android:color/transparent">
    <LinearLayout
        android:id="@+id/ll_main"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_border"
        android:padding="5dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="10dp">
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="******样品检测"
            style="@style/text_secondTitle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_electrical_concentration"
                style="@style/text_thirdTitle"/>
            <TextView
                android:id="@+id/tv_CO_elec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_no"/>
            <TextView
                android:id="@+id/tv_unit_elec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_colorimetric_concentration"
                style="@style/text_thirdTitle"/>
            <TextView
                android:id="@+id/tv_CO_colo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_no"/>
            <TextView
                android:id="@+id/tv_unit_colo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_thermal_concentration"
                style="@style/text_thirdTitle"/>
            <TextView
                android:id="@+id/tv_CO_thermal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_no"/>
            <TextView
                android:id="@+id/tv_unit_thermal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_credibility"
                style="@style/text_thirdTitle"/>
            <TextView
                android:id="@+id/tv_credibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_credibility_false"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024年9月24日 19:11"/>
        </LinearLayout>
    </LinearLayout>
        <!-- 单选按钮 -->
        <android.widget.RadioButton
            android:id="@+id/radio_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:button="@drawable/radio_check_selector"
            android:layout_gravity="center_vertical"
            android:checked="false"/>
    </LinearLayout>

</FrameLayout>