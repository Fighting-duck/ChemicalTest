<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activitys.mine.UseLanguageActivity">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/top_nav_background"/>
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/icon_back"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_useLanguage"
            style="@style/text_topBarTitle"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D3D3D6"
            android:layout_gravity="bottom"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">
        <FrameLayout
            android:id="@+id/fl_selectCH"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/language_round_selector">
            <ImageView
                android:id="@+id/iv_selectCH"
                android:layout_width="20dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_select_blue"
                android:layout_marginStart="10dp"
                android:layout_gravity="center_vertical"
                tools:ignore="RtlHardcoded" />
            <TextView
                android:id="@+id/tv_selectCH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_ch"
                android:textColor="@drawable/language_text_selector"
                android:textSize="18sp"
                android:layout_marginStart="50dp"
                android:layout_gravity="center_vertical"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_selectEN"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/language_round_selector"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/iv_selectEN"
                android:layout_width="20dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_select_blue"
                android:layout_marginStart="10dp"
                android:layout_gravity="center_vertical"
                tools:ignore="RtlHardcoded"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/tv_selectEN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_en"
                android:textColor="@drawable/language_text_selector"
                android:textSize="18sp"
                android:layout_marginStart="50dp"
                android:layout_gravity="center_vertical"/>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>