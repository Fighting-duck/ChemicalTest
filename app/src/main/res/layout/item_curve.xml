<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@android:color/transparent">
    <LinearLayout
        android:id="@+id/ll_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_border"
        android:orientation="vertical"
        android:padding="5dp">
        <!-- 第一行：曲线名字、编辑按钮、删除按钮 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="35dp">
            <!-- 标准曲线名字 -->
            <TextView
                android:id="@+id/tv_curveName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:textSize="16sp"
                style="@style/text_secondTitle"/>

            <!-- 单选按钮 -->
            <android.widget.RadioButton
                android:id="@+id/radio_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:button="@drawable/radio_check_selector"
                android:layout_gravity="center_vertical"
                android:checked="false"/>
        </LinearLayout>

        <!-- 第二行：曲线类型和检测样本 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/curveManage_type"
                    android:textSize="12sp"
                    style="@style/text_thirdTitle"/>

                <TextView
                    android:id="@+id/tv_curveType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/curveManage_sample"
                    android:textSize="12sp"
                    style="@style/text_thirdTitle"/>
                <TextView
                    android:id="@+id/tv_sample"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第三行：添加时间、函数公式和相关系数 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/curveManage_formula"
                    android:textSize="12sp"
                    style="@style/text_thirdTitle"/>

                <TextView
                    android:id="@+id/tv_formula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/curveManage_corr"
                    android:textSize="12sp"
                    style="@style/text_thirdTitle"/>
                <TextView
                    android:id="@+id/tv_corr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>