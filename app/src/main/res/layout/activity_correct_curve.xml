<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.smpleTest.manage.CorrectCurveActivity">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/top_nav_background"/>
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/icon_back"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_correct_standard_curve"
            style="@style/text_topBarTitle"/>
        <ImageView
            android:id="@+id/iv_save"
            android:layout_width="30dp"
            android:layout_height="27dp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginEnd="20dp"
            android:background="@drawable/icon_save" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D3D3D6"
            android:layout_gravity="bottom"/>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">
            <TextView
                android:id="@+id/tv_curveName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/text_firstTitle"
                android:text="@string/default_no"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/splitLine"
                android:layout_marginTop="@dimen/dp_10"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/splitLine"/>
                <TextView
                    android:id="@+id/tv_sequenceNumber"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="@string/correctCurve_sequenceNumber"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />
                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/splitLine"/>
                <TextView
                    android:id="@+id/tv_CO"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/correctCurve_CO"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />
                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/splitLine"/>
                <TextView
                    android:id="@+id/tv_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/correctCurve_Y"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />
                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/splitLine"/>
                <TextView
                    android:id="@+id/tv_TestCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/correctCurve_TestY"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />
                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/splitLine"/>
                <TextView
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="wrap_content"
                    android:text="@string/correctCurve_Test"
                    android:gravity="center" />
                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/splitLine"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/splitLine"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_curveList"
                android:layout_width="match_parent"
                android:layout_height="400dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">
                <com.github.mikephil.charting.charts.CombinedChart
                    android:id="@+id/cc_oldChart"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:background="@color/white" />
                <com.github.mikephil.charting.charts.CombinedChart
                    android:id="@+id/cc_newChart"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:background="@color/white" />
            </LinearLayout>
            <!--详情表格-->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1,2"
                android:shrinkColumns="0">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_oldChart"
                        android:gravity="center"
                        android:background="@drawable/cell_border"
                        android:padding="5dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_newChart"
                        android:gravity="center"
                        android:background="@drawable/cell_border"
                        android:padding="5dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_K"
                        android:background="#F5F5F5"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tv_oldK"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                    <TextView
                        android:id="@+id/tv_newK"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_B"
                        android:background="#F5F5F5"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tv_oldB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                    <TextView
                        android:id="@+id/tv_newB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_R"
                        android:background="#F5F5F5"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tv_oldR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                    <TextView
                        android:id="@+id/tv_newR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_R_2"
                        android:background="#F5F5F5"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tv_oldR_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                    <TextView
                        android:id="@+id/tv_newR_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_MSE"
                        android:background="#F5F5F5"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tv_oldMse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                    <TextView
                        android:id="@+id/tv_newMse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                    </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correctCurve_Expression"
                        android:background="#F5F5F5"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tv_oldExpression"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                    <TextView
                        android:id="@+id/tv_newExpression"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"
                        android:background="@drawable/cell_border"
                        android:gravity="center"
                        android:padding="5dp"/>
                </TableRow>
            </TableLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/correctCurve_isAlter"/>
                <TextView
                    android:id="@+id/tv_isAlter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>