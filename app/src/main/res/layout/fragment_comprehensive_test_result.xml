<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".fragments.ComprehensiveTestResultFragment">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historyPreview_standardCurve"
            style="@style/text_firstTitle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historyPreview_standardCurve_elec"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                style="@style/text_thirdTitle"/>
            <TextView
                android:id="@+id/tv_standardCurve_elec"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textStyle="bold|italic"
                android:textColor="@color/line_electric"
                android:text="@string/default_no"
                android:clickable="false"
                android:gravity="center_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historyPreview_standardCurve_colo"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                style="@style/text_thirdTitle"/>
            <TextView
                android:id="@+id/tv_standardCurve_colo"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textStyle="bold|italic"
                android:textColor="@color/line_colorimetric"
                android:text="@string/default_no"
                android:clickable="false"
                android:gravity="center_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historyPreview_standardCurve_thermal"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                style="@style/text_thirdTitle"/>
            <TextView
                android:id="@+id/tv_standardCurve_thermal"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textStyle="bold|italic"
                android:textColor="@color/line_thermal"
                android:text="@string/default_no"
                android:clickable="false"
                android:gravity="center_vertical"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historyPreview_result"
            android:layout_marginTop="10dp"
            style="@style/text_firstTitle"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_radius_20_2"
            android:padding="10dp"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historyPreview_results_electrical"
                    style="@style/text_secondTitle"/>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="10dp"
                    android:background="@color/line_electric"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background_border_2"
                android:padding="10dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/historyPreview_dataTime"
                        style="@style/text_thirdTitle"/>
                    <TextView
                        android:id="@+id/tv_dataTime_elec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/historyPreview_deviceInfo"
                        style="@style/text_thirdTitle"/>
                    <TextView
                        android:id="@+id/tv_deviceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historyPreview_14_records"
                    android:layout_marginTop="5dp"
                    style="@style/text_thirdTitle"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D3D3D6"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white">
                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D3D3D6"/>
                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/historyPreview_sequenceNumber"
                        android:gravity="center"/>
                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D3D3D6"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/historyPreview_value"/>
                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D3D3D6"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/historyPreview_unit"/>
                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D3D3D6"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/historyPreview_time"/>
                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D3D3D6"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D3D3D6"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_records"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@color/white"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_MaxValue_4"
                        style="@style/text_thirdTitle"/>
                    <TextView
                        android:id="@+id/tv_maxValue_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"/>
                    <TextView
                        android:id="@+id/tv_elec_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_detection_concentration"
                        style="@style/text_thirdTitle"/>
                    <TextView
                        android:id="@+id/tv_CO_elec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_no"/>
                    <TextView
                        android:id="@+id/tv_CO_elec_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"/>
                    <ImageView
                        android:id="@+id/iv_Elec_AbnormalJudgment"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_notice_normal"
                        android:visibility="gone"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_disease_analysis"
                    android:layout_marginTop="5dp"
                    style="@style/text_thirdTitle"/>
                <TextView
                    android:id="@+id/tv_diseaseAnalysis_electrical"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/default_no_text"
                    android:scrollbars="vertical"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historyPreview_results_colorimetric_image"
                    style="@style/text_secondTitle"/>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="10dp"
                    android:background="@color/line_colorimetric"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background_border_2"
                android:padding="10dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:background="@color/white">
                        <ImageView
                            android:id="@+id/iv_originalImage"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/icon_no_image"
                            android:layout_gravity="center_horizontal"
                            android:scaleType="fitXY"/>
                        <ImageView
                            android:id="@+id/iv_cropImage"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/icon_no_image"
                            android:layout_marginTop="10dp"
                            android:layout_gravity="center_horizontal"
                            android:scaleType="fitXY"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/historyPreview_dataTime"
                                style="@style/text_thirdTitle"/>
                            <TextView
                                android:id="@+id/tv_dataTime_colo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/default_no"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_Corrected_RGB_color"
                                style="@style/text_thirdTitle"/>
                            <TextView
                                android:id="@+id/tv_correctedColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_no"/>
                            <TextView
                                android:id="@+id/tv_showColor"
                                android:layout_width="20dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="10dp"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/colorimetric_Hue"
                                    style="@style/text_thirdTitle"/>
                                <TextView
                                    android:id="@+id/tv_hue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_no"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/colorimetric_Red"
                                    style="@style/text_thirdTitle"/>
                                <TextView
                                    android:id="@+id/tv_red"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_no"/>
                            </LinearLayout>

                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/colorimetric_Saturation"
                                    style="@style/text_thirdTitle"/>
                                <TextView
                                    android:id="@+id/tv_Saturation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_no"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/colorimetric_Green"
                                    style="@style/text_thirdTitle"/>
                                <TextView
                                    android:id="@+id/tv_green"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_no"/>
                            </LinearLayout>

                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/colorimetric_Value"
                                    style="@style/text_thirdTitle"/>
                                <TextView
                                    android:id="@+id/tv_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_no"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/colorimetric_Blue"
                                    style="@style/text_thirdTitle"/>
                                <TextView
                                    android:id="@+id/tv_blue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_no"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_detection_concentration"
                                style="@style/text_thirdTitle"/>
                            <TextView
                                android:id="@+id/tv_CO_colo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_no"/>
                            <TextView
                                android:id="@+id/tv_CO_colo_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"/>
                            <ImageView
                                android:id="@+id/iv_Colo_AbnormalJudgment"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_notice_normal"
                                android:visibility="gone"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_disease_analysis"
                    android:layout_marginTop="5dp"
                    style="@style/text_thirdTitle"/>
                <TextView
                    android:id="@+id/tv_diseaseAnalysis_colorimetric"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/default_no"
                    android:maxLines="3"
                    android:scrollbars="vertical"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historyPreview_results_thermal_image"
                    style="@style/text_secondTitle"/>
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="10dp"
                    android:background="@color/line_thermal"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/rl_image_thermal"
                    android:orientation="vertical"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:background="@color/white">
                    <ImageView
                        android:id="@+id/iv_thermalImage"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/icon_no_image"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/background_border_2"
                    android:padding="10dp">
                    <LinearLayout
                        android:id="@+id/ll_deviceInfo_degree"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/historyPreview_deviceInfo"
                            style="@style/text_thirdTitle"/>
                        <TextView
                            android:id="@+id/tv_deviceInfo_degree"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/default_no"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/historyPreview_dataTime"
                            style="@style/text_thirdTitle"/>
                        <TextView
                            android:id="@+id/tv_dataTime_thermal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/default_no"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_center_temperature"
                            style="@style/text_thirdTitle"/>
                        <TextView
                            android:id="@+id/tv_centerTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_no"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/unit_degree"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_detection_concentration"
                            style="@style/text_thirdTitle"/>
                        <TextView
                            android:id="@+id/tv_CO_thermal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_no"/>
                        <TextView
                            android:id="@+id/tv_CO_thermal_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"/>
                        <ImageView
                            android:id="@+id/iv_Thermal_AbnormalJudgment"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icon_notice_normal"
                            android:visibility="gone"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_disease_analysis"
                        android:layout_marginTop="5dp"
                        style="@style/text_thirdTitle"/>
                    <TextView
                        android:id="@+id/tv_diseaseAnalysis_thermal"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/default_no"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>