<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 单元格背景色（白色） -->
    <solid android:color="#FFFFFF" />

    <!-- 边框：宽度1dp，颜色灰色 -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD" />

    <!-- 可选：单元格内边距（避免文字紧贴边框） -->
    <padding
        android:left="8dp"
        android:right="8dp" />

</shape>